ALLOW_HEURISTIC_EXTRACTION_FALLBACK=true
ANSWER_MAX_TOKENS=1200
ANSWER_RETRIES=1
MIN_ANSWER_CHARS=80
JUDGE_MAX_TOKENS=700
JUDGE_PARSE_RETRIES=1
